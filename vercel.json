{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    }
  ],
  "installCommand": "npm --prefix backend ci",
  "routes": [
    {
      "src": "/(.*)",
      "dest": "backend/server.js"
    }
  ],
  "functions": {
    "backend/server.js": {
      "includeFiles": [
        "frontend/**",
        "admin/**",
        "backend/data/**",
        "backend/uploads/**"
      ]
    }
  }
}
